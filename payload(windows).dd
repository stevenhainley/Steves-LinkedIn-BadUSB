DELAY 5000

REM Open Run and launch Command Prompt
GUI R
DELAY 1000
STRING cmd
ENTER
DELAY 4000

REM Download the resume, open it in Microsoft Edge, then close Command Prompt
REM Replace the quoted HTTPS URL with the direct link to your own resume PDF
STRING curl.exe -fL -o "%TEMP%\Steven_Hainley_Resume.pdf" "https://raw.githubusercontent.com/stevenhainley/Steves-LinkedIn-BadUSB/main/Steven_Hainley_Resume.pdf" && start "" msedge.exe --new-window "%TEMP%\Steven_Hainley_Resume.pdf" && exit
ENTER
